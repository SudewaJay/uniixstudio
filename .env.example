# ---- Tracking & Analytics (all optional) ----
# Set in Vercel → Project Settings → Environment Variables → Production.
# Locally these can be left blank — the scripts simply no-op.

# Google Analytics 4
# Get from: analytics.google.com → Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity (heatmaps + session recordings)
# Get from: clarity.microsoft.com → New project → Settings → Project ID
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console verification
# Get from: search.google.com/search-console → Add property → HTML tag method →
# copy ONLY the content="..." value (not the full <meta> tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification
# Get from: bing.com/webmasters → Add site → Meta tag option →
# copy the content="..." value
NEXT_PUBLIC_BING_SITE_VERIFICATION=
