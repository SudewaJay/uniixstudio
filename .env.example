# Database connection string (Neon Postgres in production; DATABASE_URI is also accepted)
DATABASE_URL=

# Random 32+ byte string used to sign Payload CMS auth cookies and JWTs
PAYLOAD_SECRET=

# Public canonical URL for the website (e.g. https://www.uniixstudio.com)
NEXT_PUBLIC_SITE_URL=

# Vercel Blob access token for Payload media uploads and responsive assets
BLOB_READ_WRITE_TOKEN=

# Resend API key for sending contact form notification emails
RESEND_API_KEY=

# Destination email address where contact form submissions are delivered
CONTACT_TO_EMAIL=

# Verified sender email address for contact form notifications (e.g. Uniix Studio <noreply@uniixstudio.com>)
CONTACT_FROM=

# Cloudinary cloud name for legacy assets and fast delivery
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Optional env fallback for GA4 measurement ID (overridden by Site Settings in CMS)
NEXT_PUBLIC_GA_ID=

# Optional env fallback for Microsoft Clarity project ID (overridden by Site Settings in CMS)
NEXT_PUBLIC_CLARITY_ID=

# Optional env fallback for Meta Pixel ID (overridden by Site Settings in CMS)
NEXT_PUBLIC_META_PIXEL_ID=

# Optional env fallback for Google site verification token (overridden by Site Settings in CMS)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional env fallback for Bing site verification token (overridden by Site Settings in CMS)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Seed option: set to 1 to update existing documents matched by slug instead of skipping them
SEED_UPDATE_EXISTING=

# Seed option: set to 1 to simulate the import and report changes without writing to database
SEED_DRY_RUN=
