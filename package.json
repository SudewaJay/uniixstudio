{
  "name": "uniix-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node node_modules/payload/bin.js run tests/cms.int.ts",
    "test:smoke": "node tests/smoke.mjs",
    "payload": "node node_modules/payload/bin.js",
    "cms:migrate": "node node_modules/payload/bin.js migrate",
    "cms:migrate:status": "node node_modules/payload/bin.js migrate:status",
    "cms:seed": "node node_modules/payload/bin.js run scripts/cms/seed.ts",
    "cms:types": "node node_modules/payload/bin.js generate:types && node node_modules/payload/bin.js generate:importmap",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-vercel-blob": "^3.84.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.0",
    "graphql": "^16.13.2",
    "gray-matter": "^4.0.3",
    "next": "~15.4.11",
    "next-cloudinary": "^6.17.5",
    "payload": "^3.84.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.11",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
